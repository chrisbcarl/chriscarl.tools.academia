    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug: Python",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
        },
        {
            "name": "[academia] config set",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/chriscarl/tools/academia.py",
            "console": "integratedTerminal",
            "args": [
                "config", "default", "year=2026", "semester=Spring",
                "config", "set", "cmpe-180c", "year=2024", "--inactive",
                // "--config-filepath", "ignoreme/config.json",
            ],
            "justMyCode": true,
        },
    ]
}